  "requires": true,
  "packages": {
    "": {
      "name": "ledgerly",
      "version": "1.4.2",
      "license": "UNLICENSED",
      "workspaces": [
        "packages/*",
        "api",
        "web"
      ],
      "engines": {
        "node": ">=22.6"
      }
    },
    "api": {
      "name": "@ledgerly/api",
